@baseUrl = http://localhost:3000/api

### 1. Bob s'inscrit et ESSAIE de se mettre admin → 201, role doit rester "user"
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "bob@test.com",
  "password": "Secret123!",
  "firstname": "Bob",
  "role": "admin"
}

### 2. Login avec un mauvais mot de passe → 401
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "mauvais" }

### 3. Login de Bob → 200 + token
# @name loginBob
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "Secret123!" }

### 4. Qui suis-je ? (token de Bob) → 200, Bob
GET {{baseUrl}}/me
Authorization: Bearer {{loginBob.response.body.token}}

### 5. Qui suis-je ? SANS token → 401
GET {{baseUrl}}/me

### 6. Bob essaie de lister les users → 403
GET {{baseUrl}}/users
Authorization: Bearer {{loginBob.response.body.token}}

### 7. Login d'Alice (admin) → 200 + token
# @name loginAlice
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "alice@test.com", "password": "Secret123!" }

### 8. Alice liste les users → 200
GET {{baseUrl}}/users
Authorization: Bearer {{loginAlice.response.body.token}}

###
// categories liste publique
GET {{baseUrl}}/categories

###
// categories creation refusee user
POST {{baseUrl}}/categories
Authorization: Bearer {{loginBob.response.body.token}}
Content-Type: application/json

{ "name": "Audio" }

###
// categories creation admin
POST {{baseUrl}}/categories
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "name": "Audio", "description": "Micros, enceintes" }

###
// categories nom manquant
POST {{baseUrl}}/categories
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "description": "pas de nom" }

###
// equipments creation admin
POST {{baseUrl}}/equipments
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "name": "Micro Shure SM58", "categoryId": 1 }

###
// equipments statut invalide
POST {{baseUrl}}/equipments
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "name": "Projecteur", "status": "broken" }

###
// equipments liste avec categorie
GET {{baseUrl}}/equipments

###
// equipments filtre et tri
GET {{baseUrl}}/equipments?status=available&sort=-name

###
// equipments modification refusee user
PATCH {{baseUrl}}/equipments/1
Authorization: Bearer {{loginBob.response.body.token}}
Content-Type: application/json

{ "status": "retired" }

###
// equipments modification admin
PATCH {{baseUrl}}/equipments/1
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "status": "maintenance" }

###
// equipments id inexistant
GET {{baseUrl}}/equipments/999

###
// usage-logs sans token
GET {{baseUrl}}/usage-logs

###
// usage-logs lecture refusee user
GET {{baseUrl}}/usage-logs
Authorization: Bearer {{loginBob.response.body.token}}

###
// usage-logs creation admin
POST {{baseUrl}}/usage-logs
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "type": "maintenance", "notes": "Grille du micro changée", "equipmentId": 1, "userId": 2 }

###
// usage-logs type invalide
POST {{baseUrl}}/usage-logs
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "type": "lost", "equipmentId": 1 }

###
// usage-logs equipement manquant
POST {{baseUrl}}/usage-logs
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "type": "repair" }

###
// usage-logs historique equipement 1
GET {{baseUrl}}/usage-logs?equipmentId=1&sort=-date
Authorization: Bearer {{loginAlice.response.body.token}}

###
// usage-logs modification notes
PATCH {{baseUrl}}/usage-logs/1
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "notes": "Grille et câble changés" }

###
// usage-logs suppression id inexistant
DELETE {{baseUrl}}/usage-logs/999
Authorization: Bearer {{loginAlice.response.body.token}}
