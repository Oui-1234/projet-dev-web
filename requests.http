@baseUrl = http://localhost:3000/api

### 1. Bob s'inscrit et ESSAIE de se mettre admin → 201, role doit rester "user"
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "bob@test.com",
  "password": "Secret123!",
  "firstname": "Bob",
  "role": "admin"
}

### 2. Login avec un mauvais mot de passe → 401
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "mauvais" }

### 3. Login de Bob → 200 + token
# @name loginBob
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "bob@test.com", "password": "Secret123!" }

### 4. Qui suis-je ? (token de Bob) → 200, Bob
GET {{baseUrl}}/me
Authorization: Bearer {{loginBob.response.body.token}}

### 5. Qui suis-je ? SANS token → 401
GET {{baseUrl}}/me

### 6. Bob essaie de lister les users → 403
GET {{baseUrl}}/users
Authorization: Bearer {{loginBob.response.body.token}}

### 7. Login d'Alice (admin) → 200 + token
# @name loginAlice
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "alice@test.com", "password": "Secret123!" }

### 8. Alice liste les users → 200
GET {{baseUrl}}/users
Authorization: Bearer {{loginAlice.response.body.token}}

###
// categories liste publique
GET {{baseUrl}}/categories

###
// categories creation refusee user
POST {{baseUrl}}/categories
Authorization: Bearer {{loginBob.response.body.token}}
Content-Type: application/json

{ "name": "Audio" }

###
// categories creation admin
POST {{baseUrl}}/categories
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "name": "Audio", "description": "Micros, enceintes" }

###
// categories nom manquant
POST {{baseUrl}}/categories
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "description": "pas de nom" }

###
// equipments creation admin
POST {{baseUrl}}/equipments
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "name": "Micro Shure SM58", "categoryId": 1 }

###
// equipments statut invalide
POST {{baseUrl}}/equipments
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "name": "Projecteur", "status": "broken" }

###
// equipments liste avec categorie
GET {{baseUrl}}/equipments

###
// equipments filtre et tri
GET {{baseUrl}}/equipments?status=available&sort=-name

###
// equipments modification refusee user
PATCH {{baseUrl}}/equipments/1
Authorization: Bearer {{loginBob.response.body.token}}
Content-Type: application/json

{ "status": "retired" }

###
// equipments modification admin
PATCH {{baseUrl}}/equipments/1
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "status": "maintenance" }

###
// equipments id inexistant
GET {{baseUrl}}/equipments/999

###
// usage-logs sans token
GET {{baseUrl}}/usage-logs

###
// usage-logs lecture refusee user
GET {{baseUrl}}/usage-logs
Authorization: Bearer {{loginBob.response.body.token}}

###
// usage-logs creation admin
POST {{baseUrl}}/usage-logs
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "type": "maintenance", "notes": "Grille du micro changée", "equipmentId": 1, "userId": 2 }

###
// usage-logs type invalide
POST {{baseUrl}}/usage-logs
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "type": "lost", "equipmentId": 1 }

###
// usage-logs equipement manquant
POST {{baseUrl}}/usage-logs
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "type": "repair" }

###
// usage-logs historique equipement 1
GET {{baseUrl}}/usage-logs?equipmentId=1&sort=-date
Authorization: Bearer {{loginAlice.response.body.token}}

###
// usage-logs modification notes
PATCH {{baseUrl}}/usage-logs/1
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "notes": "Grille et câble changés" }

###
// usage-logs suppression id inexistant
DELETE {{baseUrl}}/usage-logs/999
Authorization: Bearer {{loginAlice.response.body.token}}


### ===== ÉTAPE 5 =====

### 5.0 L'admin remet l'équipement 1 en "available" (le test 4.10 l'avait mis en maintenance) → 200
PATCH {{baseUrl}}/equipments/1
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "status": "available" }

### 5.1 Carol s'inscrit → 201 (la 1re fois seulement)
POST {{baseUrl}}/register
Content-Type: application/json

{ "email": "carol@test.com", "password": "Secret123!", "firstname": "Carol" }

### 5.2 Login de Carol → 200 + token
# @name loginCarol
POST {{baseUrl}}/login
Content-Type: application/json

{ "email": "carol@test.com", "password": "Secret123!" }

### 5.3 Sans token → 401
GET {{baseUrl}}/reservations

### 5.4 Bob réserve l'équipement 1 et ESSAIE de mettre userId et status → 201, "pending", userId = celui de Bob
# @name bobResa
POST {{baseUrl}}/reservations
Authorization: Bearer {{loginBob.response.body.token}}
Content-Type: application/json

{ "equipmentId": 1, "startDate": "2026-12-01", "endDate": "2026-12-05", "userId": 1, "status": "approved" }

### 5.5 Carol veut le même équipement sur des dates qui chevauchent → 409
POST {{baseUrl}}/reservations
Authorization: Bearer {{loginCarol.response.body.token}}
Content-Type: application/json

{ "equipmentId": 1, "startDate": "2026-12-04", "endDate": "2026-12-08" }

### 5.6 Carol réserve juste après → 201
# @name carolResa
POST {{baseUrl}}/reservations
Authorization: Bearer {{loginCarol.response.body.token}}
Content-Type: application/json

{ "equipmentId": 1, "startDate": "2026-12-06", "endDate": "2026-12-08", "comment": "Pour un concert" }

### 5.7 Dates inversées → 422
POST {{baseUrl}}/reservations
Authorization: Bearer {{loginCarol.response.body.token}}
Content-Type: application/json

{ "equipmentId": 1, "startDate": "2027-01-10", "endDate": "2027-01-01" }

### 5.8 Bob liste en demandant celles de Carol → 200, mais SEULEMENT les siennes
GET {{baseUrl}}/reservations?userId={{carolResa.response.body.userId}}
Authorization: Bearer {{loginBob.response.body.token}}

### 5.9 L'admin liste tout → 200, celles de Bob ET de Carol
GET {{baseUrl}}/reservations
Authorization: Bearer {{loginAlice.response.body.token}}

### 5.10 Bob essaie de voir la réservation de Carol → 404
GET {{baseUrl}}/reservations/{{carolResa.response.body.id}}
Authorization: Bearer {{loginBob.response.body.token}}

### 5.11 Bob essaie d'approuver sa propre réservation → 403
PATCH {{baseUrl}}/reservations/{{bobResa.response.body.id}}
Authorization: Bearer {{loginBob.response.body.token}}
Content-Type: application/json

{ "status": "approved" }

### 5.12 Bob essaie d'annuler celle de Carol → 404
PATCH {{baseUrl}}/reservations/{{carolResa.response.body.id}}
Authorization: Bearer {{loginBob.response.body.token}}
Content-Type: application/json

{ "status": "cancelled" }

### 5.13 L'admin approuve celle de Bob → 200
PATCH {{baseUrl}}/reservations/{{bobResa.response.body.id}}
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "status": "approved" }

### 5.14 L'admin essaie de la remettre en attente → 422 (transition interdite)
PATCH {{baseUrl}}/reservations/{{bobResa.response.body.id}}
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "status": "pending" }

### 5.15 L'admin la marque comme rendue → 200
PATCH {{baseUrl}}/reservations/{{bobResa.response.body.id}}
Authorization: Bearer {{loginAlice.response.body.token}}
Content-Type: application/json

{ "status": "returned" }

### 5.16 Carol annule la sienne → 200
PATCH {{baseUrl}}/reservations/{{carolResa.response.body.id}}
Authorization: Bearer {{loginCarol.response.body.token}}
Content-Type: application/json

{ "status": "cancelled" }

### 5.17 Bob essaie de supprimer → 403
DELETE {{baseUrl}}/reservations/{{carolResa.response.body.id}}
Authorization: Bearer {{loginBob.response.body.token}}

### 5.18 L'admin supprime → 204
DELETE {{baseUrl}}/reservations/{{carolResa.response.body.id}}
Authorization: Bearer {{loginAlice.response.body.token}}
